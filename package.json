{
  "name": "dsh-team-workflow",
  "version": "0.2.2",
  "private": true,
  "description": "团队基线工作流插件包（dsh 版）：团队规范注入、审计日志、上下文节流、rtk 输出压缩、pi-lens 代码智能、团队预设与 CLI。",
  "type": "module",
  "license": "MIT",
  "author": "sanjiu2024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjiu2024/dsh-team-workflow.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "team",
    "workflow"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-team": "./bin/dsh-team.mjs"
  },
  "files": [
    "lib",
    "bin",
    "team",
    "skills",
    "presets",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/selftest.mjs"
  },
  "engines": {
    "node": ">=22.19"
  }
}
