{
  // ── 这份文件由 dsh-team-workflow 维护（`dsh-team mc apply` 写入） ──
  //
  // 只放「必须覆盖 magic-context 默认值」的键。mc 的配置是
  // **深合并 + 逐键回落默认值**（bundle 的 mergeRawConfigs + zod schema），
  // 所以这里没写的键一律走 mc 自己的默认，不会因为这份文件而丢设置。
  //
  // 为什么是 65%（mc 的默认值）而不是 REQ-003 里那个 20%：
  // 2026-10-08 用户要求「不要在 128K 就压」，dsh 阈值从 25% 抬到 70%（358K），
  // 于是 REQ-003 那套「把 mc 压到 20% 抢在 dsh 前面动手」的临时对策整个撤销，
  // mc 回到默认 65%（333K）、配套的 history 预算补偿 0.45 也回默认 0.15。
  // 见 docs/requirements/REQ-003-mc与dsh压缩阈值冲突.md（2026-10-08 修订节）。
  //
  // 不变式（自检锁住）：mc 的执行阈值必须 **低于** dsh 自带压缩阈值，
  // 否则 dsh 会先动手、mc 的排队操作永远不执行（实测：mc 0 次出手、
  // 26 个 drop 积压未执行、dsh 一天压 83 次）。
  //   dsh 压缩阈值 = 70%  （team/agent-settings.json：512000 × 0.70 = 358400）
  //   mc 执行阈值  = 65%  ← 本文件（= mc 的默认值）
  //   mc 主动触发  = 63%  （mc 固定取「执行阈值 − 2」）
  // 两者之间留 5 个百分点（≈26K token）余量，避免同时动手。
  "execute_threshold_percentage": 65,

  // history block 预算：**显式写回默认 0.15，是为了撤掉 20% 时代的补偿。**
  //
  // 2026-10-08 之前这里写 0.45：mc 算它的方式是
  // `窗口 × (执行阈值/100) × 本百分比`，阈值被压到 20% 时不补偿会让绝对预算缩水 69%：
  //   改前（65% × 0.15）：512000 × 0.65 × 0.15 = 49,920
  //   不补偿（20% × 0.15）：512000 × 0.20 × 0.15 = 15,360（-69%，mc 注入历史的能力退化）
  //   当时的补偿（20% × 0.45）：512000 × 0.20 × 0.45 = 46,080（≈ 改前的 92%）
  // 阈值抬回 65% 后补偿不再需要，写回默认：512000 × 0.65 × 0.15 = 49,920（与改前一致）。
  // **必须显式写**：mc apply 只写模板里有的键，不写就会把上次 apply 的 0.45 留在用户配置里，
  // 那时预算变成 512000 × 0.65 × 0.45 = 149,760 —— 不是我们要的。
  // 注：这是**上限**不是实际注入量；具体注入多少仍由内容决定。schema 允许范围 0.05–0.5。
  "history_budget_percentage": 0.15
}
