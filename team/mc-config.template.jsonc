{
  // ── 这份文件由 dsh-team-workflow 维护（`dsh-team mc apply` 写入） ──
  //
  // 只放「必须覆盖 magic-context 默认值」的键。mc 的配置是
  // **深合并 + 逐键回落默认值**（bundle 的 mergeRawConfigs + zod schema），
  // 所以这里没写的键一律走 mc 自己的默认，不会因为这份文件而丢设置。
  //
  // 为什么必须压到 20%：见 docs/requirements/REQ-003-mc与dsh压缩阈值冲突.md
  //
  // 不变式（自检锁住）：mc 的执行阈值必须 **低于** dsh 自带压缩阈值，
  // 否则 dsh 会先动手、mc 的排队操作永远不执行（实测：mc 0 次出手、
  // 26 个 drop 积压未执行、dsh 一天压 83 次）。
  //   dsh 压缩阈值 = 25%  （team/agent-settings.json：512000 × 0.25 = 128000）
  //   mc 执行阈值  = 20%  ← 本文件
  //   mc 主动触发  = 18%  （mc 固定取「执行阈值 − 2」）
  // 两者之间留 5 个百分点（≈25K token）余量，避免同时动手。
  "execute_threshold_percentage": 20,

  // history block 预算：**这是 20% 的配套补偿，不是独立调优。**
  //
  // mc 算它的方式是 `窗口 × (执行阈值/100) × 本百分比`，所以阈值一降、
  // 默认的 0.15 会让绝对预算跟着缩水：
  //   改前：512000 × 0.65 × 0.15 = 49,920
  //   不补偿：512000 × 0.20 × 0.15 = 15,360（-69%，mc 注入历史的能力退化）
  //   补偿后：512000 × 0.20 × 0.45 = 46,080（≈ 改前的 92%）
  // 即「让绝对预算保持同量级」—— 降阈值是为了让 mc 先动手，不是为了砍它的历史预算。
  // 注：这是**上限**不是实际注入量；具体注入多少仍由内容决定。
  // schema 允许范围 0.05–0.5。第 3 层审查特别指出过这一点（bundle 对
  // 该副作用不给任何警告），首选值未实测，见 REQ-003 §7。
  "history_budget_percentage": 0.45
}
